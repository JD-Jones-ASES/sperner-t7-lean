module

/-!
# The kernel certificates for tournaments on at most six vertices

A Mathlib-free leaf (lane: six). For each `n ≤ 6`: the pairs `a < b < n`, the `n!` permutations,
and one representative of each of the 1, 1, 1, 2, 4, 12, 56 classes of tournaments on `n` vertices
with a factorization over `ZMod 2` of rank `t` (rows of `A`, columns of `B`, as bitmasks) and a
transitive chain of length `t`. Two kernel facts per `n`: the data checks (`six_dataOK`) and the
coverage bitset (`six_cover`): every code of a tournament on the listed pairs is the code of a
relabelled representative. Every evaluated function is an explicit recursor.
-/

@[expose] public section

namespace SpernerCapacity

/-- A class representative: the arcs of the tournament (bit `8 * x + y` for `x → y`), the size `t`
of a transitive chain, the rows of `A` and the columns of `B` as bitmasks of length `t`, and the
chain. -/
structure SixRep where
  code : Nat
  t : Nat
  arows : List Nat
  bcols : List Nat
  chain : List Nat

/-- The `k`-th entry of a list (`0` past the end). -/
noncomputable def six_get (l : List Nat) (k : Nat) : Nat :=
  List.rec (motive := fun _ => Nat → Nat) (fun _ => 0)
    (fun h _ ih k => Nat.rec (motive := fun _ => Nat) h (fun j _ => ih j) k) l k

/-- The arc relation of a code: `x → y` iff bit `8 * x + y` is set. -/
def six_relB (code x y : Nat) : Bool := Nat.testBit code (8 * x + y)

/-- The code of a Boolean relation on the listed pairs: bit `i` is the value on the `i`-th pair. -/
noncomputable def six_code (g : Nat → Nat → Bool) (ps : List (Nat × Nat)) : Nat :=
  List.rec (motive := fun _ => Nat) 0 (fun p _ ih => 2 * ih + (g p.1 p.2).toNat) ps

/-- The code of a representative relabelled by a permutation (given as the list of images). -/
noncomputable def six_relabel (code : Nat) (l : List Nat) (ps : List (Nat × Nat)) : Nat :=
  six_code (fun a b => six_relB code (six_get l a) (six_get l b)) ps

/-- The bitset of the codes of all relabellings of one representative. -/
noncomputable def six_coverPerms (code : Nat) (ps : List (Nat × Nat)) (perms : List (List Nat)) :
    Nat :=
  List.rec (motive := fun _ => Nat) 0 (fun l _ ih => (1 <<< six_relabel code l ps) ||| ih) perms

/-- The bitset of the codes of all relabellings of all representatives. -/
noncomputable def six_cover (ps : List (Nat × Nat)) (perms : List (List Nat)) (reps : List SixRep) :
    Nat :=
  List.rec (motive := fun _ => Nat) 0 (fun r _ ih => six_coverPerms r.code ps perms ||| ih) reps

/-- `∀ x < k, p x`, as a Boolean. -/
noncomputable def six_all (k : Nat) (p : Nat → Bool) : Bool :=
  Nat.rec (motive := fun _ => Bool) true (fun i ih => ih && p i) k

/-- `∀ a ∈ l, p a`, as a Boolean. -/
noncomputable def six_listAll {α : Type} (l : List α) (p : α → Bool) : Bool :=
  List.rec (motive := fun _ => Bool) true (fun a _ ih => p a && ih) l

/-- `∃ a ∈ l, p a`, as a Boolean. -/
noncomputable def six_listAny {α : Type} (l : List α) (p : α → Bool) : Bool :=
  List.rec (motive := fun _ => Bool) false (fun a _ ih => p a || ih) l

/-- The parity of the number of `i < t` with bit `i` set in both `a` and `b`: the entry of `A·B`
over `ZMod 2` when `a` is a row of `A` and `b` a column of `B`. -/
noncomputable def six_dot (t a b : Nat) : Bool :=
  Nat.rec (motive := fun _ => Bool) false
    (fun i ih => xor ih (Nat.testBit a i && Nat.testBit b i)) t

/-- Every pair `a < b < n` is listed. -/
noncomputable def six_pairsOK (n : Nat) (ps : List (Nat × Nat)) : Bool :=
  six_all n fun a => six_all n fun b =>
    !decide (a < b) || six_listAny ps fun p => decide (p.1 = a) && decide (p.2 = b)

/-- The list is an injective map of `{0, …, n-1}` into itself. -/
noncomputable def six_permOK (n : Nat) (l : List Nat) : Bool :=
  six_all n fun x => decide (six_get l x < n) && six_all n fun y =>
    !decide (six_get l x = six_get l y) || decide (x = y)

/-- The representative is a tournament on `{0, …, n-1}`, its factorization has nonzero diagonal
and zeros on the arcs, and its chain is transitive. -/
noncomputable def six_repOK (n : Nat) (r : SixRep) : Bool :=
  (six_all n fun x => !six_relB r.code x x && six_all n fun y =>
    decide (x = y) || !(six_relB r.code x y == six_relB r.code y x)) &&
  (six_all n fun x => six_dot r.t (six_get r.arows x) (six_get r.bcols x) && six_all n fun y =>
    !six_relB r.code x y || !six_dot r.t (six_get r.arows x) (six_get r.bcols y)) &&
  (six_all r.t fun i => decide (six_get r.chain i < n) && six_all r.t fun j =>
    !decide (i < j) || six_relB r.code (six_get r.chain i) (six_get r.chain j))

/-- All the checks on the data for `n` vertices. -/
noncomputable def six_dataOK (n : Nat) (ps : List (Nat × Nat)) (perms : List (List Nat))
    (reps : List SixRep) : Bool :=
  six_pairsOK n ps && six_listAll perms (six_permOK n) && six_listAll reps (six_repOK n)

/-- The full bitset on `2 ^ m` codes. -/
def six_full (m : Nat) : Nat := 2 ^ (2 ^ m) - 1

